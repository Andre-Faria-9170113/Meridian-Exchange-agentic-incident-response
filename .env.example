# Needed only for --mode llm. Never commit your real key.
OPENAI_API_KEY=
# Matches the course examples; change this to a model available to your account.
OPENAI_MODEL=gpt-4.1-mini
# Optional: a second model for when the first fails (outage, rate limit). Same rules apply to it.
# OPENAI_FALLBACK_MODEL=gpt-4.1
